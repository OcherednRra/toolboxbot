# --- Telegram ---
# Токен у @BotFather.
TELEGRAM_BOT_TOKEN=

# Твой chat id. Оставь пустым при первом запуске: напиши боту — он ответит
# своим chat id, впиши сюда и перезапусти. Без него бот отвечает кому угодно.
TELEGRAM_CHAT_ID=

# --- Roblox ---
# Open Cloud API-ключ: create.roblox.com/dashboard/credentials
# Скоупы: creator-store-save:write, creator-store-save:read, creator-store-product:read
# IP-ограничение: 0.0.0.0/0 (или IP сервера).
# Закладки лягут на аккаунт — владельца ключа.
ROBLOX_API_KEY=

# --- Поведение ---
# Что собирать: Model, Decal, Audio, MeshPart, Plugin, Video, FontFamily
CATEGORIES=Model,Decal,Audio,MeshPart,Plugin

# Как часто сборщик ходит за новым, минуты.
POLL_INTERVAL_MIN=15

# Сколько карточек присылать на одну /next (максимум 30).
BATCH_SIZE=10

# Потолок очереди — старое непоказанное вычищается.
MAX_QUEUE=2000

# Показывать только ассеты моложе N дней. 0 = без фильтра.
# Осторожно: по-настоящему свежего в индексе Roblox мало.
MAX_AGE_DAYS=0

# Куда класть SQLite. На Railway — точка монтирования volume.
DATA_DIR=./data
